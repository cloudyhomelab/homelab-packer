# DB_PASSWORD, POSTGRES_PASSWORD, SECRET_KEY and API_TOKEN_PEPPER_1 are in private/, decrypted on the VM

TIME_ZONE=Europe/Helsinki

ALLOWED_HOSTS=netbox.cloudyhome.net netbox.ip.cloudyhome.net localhost
CSRF_TRUSTED_ORIGINS=https://netbox.cloudyhome.net

DB_HOST=database
DB_NAME=netbox
DB_USER=netbox

POSTGRES_DB=netbox
POSTGRES_USER=netbox

REDIS_HOST=redis
REDIS_DATABASE=0
REDIS_CACHE_DATABASE=1

# the image's 4 workers and 128 threads per worker are sized for a big host; each worker is a
# full Django process. Granian warns above 2 * CPUs + 1 threads.
GRANIAN_WORKERS=1
GRANIAN_BLOCKING_THREADS=3

MEDIA_ROOT=/opt/netbox/netbox/media
SKIP_SUPERUSER=true
