[Unit]
Description=BIND9 authoritative DNS (secondary)
Wants=network-online.target
After=network-online.target
StartLimitBurst=5
StartLimitIntervalSec=300

[Container]
ContainerName=bind9
Image=bind9.image
Network=host
# -g, not the image's -L file: logs reach journald
Exec=-g -c /etc/bind/named.conf
Volume=/var/app/bind9-slave/config/named.conf:/etc/bind/named.conf:ro
Volume=/var/app/bind9-slave/config/zone-slave.conf:/etc/bind/zone-slave.conf:ro
Volume=/var/app/bind9-slave/cache:/var/cache/bind
Volume=/var/app/bind9-slave/records:/var/lib/bind
LogDriver=journald

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
