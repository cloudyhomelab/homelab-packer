# issued centrally by the acme app and fetched by caddy-iot-cert
(wildcard) {
    tls /data/wildcard/_.cloudyhome.net.crt /data/wildcard/_.cloudyhome.net.key
}

(upstream) {
    header_up Host {host}
}

# the edge routes by SNI, but browsers reuse an HTTP/2 connection for any host the wildcard
# certificate covers; 421 makes them retry on a new connection that reaches the right caddy
*.cloudyhome.net {
    import wildcard

    respond 421
}

homeassistant.cloudyhome.net {
    import wildcard

    reverse_proxy http://homeassistant.ip.cloudyhome.net:8123 {
        import upstream
    }
}
