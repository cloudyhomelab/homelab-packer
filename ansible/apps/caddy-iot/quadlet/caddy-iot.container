[Unit]
Description=Caddy IoT VLAN proxy
Wants=network-online.target
After=network-online.target caddy-iot-storage.service
Requires=caddy-iot-storage.service
StartLimitBurst=5
StartLimitIntervalSec=300

[Container]
SubUIDMap=caddy-iot
SubGIDMap=caddy-iot
# root in the container gets no override on NFS; the server checks the real owner
User=1000:1000
Sysctl=net.ipv4.ip_unprivileged_port_start=443
ContainerName=caddy-iot
Image=caddy-iot.image
Network=caddy-iot.network
Volume=/var/app/caddy-iot/config/Caddyfile:/etc/caddy/Caddyfile:ro
EnvironmentFile=/run/app/caddy-iot/private/porkbun.env
Volume=/srv/caddy-iot/data:/data
Volume=caddy-config.volume:/config:U
ReadOnly=true
PublishPort=443:443
LogDriver=journald

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
