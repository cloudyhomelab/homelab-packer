# issued centrally by the acme app and fetched by caddy-lab-cert
(wildcard) {
    tls /data/wildcard/_.cloudyhome.net.crt /data/wildcard/_.cloudyhome.net.key
}

(upstream) {
    header_up Host {host}
}

immich.cloudyhome.net {
    import wildcard

    reverse_proxy media.ip.cloudyhome.net:2283 {
        import upstream
    }
}

immich-frame.cloudyhome.net {
    import wildcard

    reverse_proxy media.ip.cloudyhome.net:8080 {
        import upstream
    }
}

youtarr.cloudyhome.net {
    import wildcard

    reverse_proxy arr-stack.ip.cloudyhome.net:3087 {
        import upstream
    }
}

jellyfin.cloudyhome.net {
    import wildcard

    reverse_proxy arr-stack.ip.cloudyhome.net:8096 {
        import upstream
    }
}

audiobookshelf.cloudyhome.net {
    import wildcard

    reverse_proxy arr-stack.ip.cloudyhome.net:13378 {
        import upstream
    }
}
