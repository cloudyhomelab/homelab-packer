[Unit]
Description=Miniflux
After=miniflux-database.service
Requires=miniflux-database.service

[Container]
SubUIDMap=miniflux
SubGIDMap=miniflux
User=65534:65534
ContainerName=miniflux
Image=miniflux.image
Network=miniflux.network
PublishPort=8080:8080
EnvironmentFile=/var/app/miniflux/config/miniflux.env
EnvironmentFile=/run/app/miniflux/private/db.env
EnvironmentFile=/run/app/miniflux/private/oauth2.env
HealthCmd=/usr/bin/miniflux -healthcheck auto
HealthInterval=30s
HealthStartPeriod=1m
HealthRetries=5
Notify=healthy

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
