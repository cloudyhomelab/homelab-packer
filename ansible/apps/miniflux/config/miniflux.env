# DATABASE_URL and POSTGRES_PASSWORD are in private/db.sops.env, decrypted on the VM

POSTGRES_DB=miniflux
POSTGRES_USER=miniflux

LISTEN_ADDR=0.0.0.0:8080
BASE_URL=https://rss.cloudyhome.net
RUN_MIGRATIONS=1
LOG_FORMAT=json

# OAUTH2_CLIENT_ID and OAUTH2_CLIENT_SECRET are in private/oauth2.sops.env
OAUTH2_PROVIDER=oidc
OAUTH2_OIDC_PROVIDER_NAME=Pocket ID
OAUTH2_OIDC_DISCOVERY_ENDPOINT=https://auth.cloudyhome.net
OAUTH2_REDIRECT_URL=https://rss.cloudyhome.net/oauth2/oidc/callback
# accounts come only from pocket-id: the first login creates them
OAUTH2_USER_CREATION=1
DISABLE_LOCAL_AUTH=1
OAUTH2_ADDITIONAL_SCOPES=groups
OAUTH2_GROUP_CLAIM=groups
# checked on every login: a user outside this group loses admin
OAUTH2_ADMIN_GROUP=admin
