[Unit]
Description=UniFi OS Server
Wants=network-online.target
After=network-online.target
StartLimitBurst=5
StartLimitIntervalSec=300

[Container]
ContainerName=unifi-os-server
Image=unifi-os-server.image
AddCapability=NET_RAW NET_ADMIN
AddHost=host.docker.internal:host-gateway
Tmpfs=/run:exec
Tmpfs=/run/lock
Tmpfs=/tmp:exec
Tmpfs=/var/lib/journal
Tmpfs=/var/opt/unifi/tmp:size=64m
Environment=UOS_SYSTEM_IP=uos.ip.cloudyhome.net
Volume=/sys/fs/cgroup:/sys/fs/cgroup:rw
Volume=/var/app/unifi-server-os/persistent:/persistent
Volume=/var/app/unifi-server-os/var-log:/var/log
Volume=/var/app/unifi-server-os/data:/data
Volume=/var/app/unifi-server-os/srv:/srv
Volume=/var/app/unifi-server-os/var-lib-unifi:/var/lib/unifi
Volume=/var/app/unifi-server-os/var-lib-mongodb:/var/lib/mongodb
Volume=/var/app/unifi-server-os/etc-rabbitmq-ssl:/etc/rabbitmq/ssl
PublishPort=11443:443
PublishPort=8080:8080
PublishPort=3478:3478/udp
PublishPort=10003:10003/udp
PublishPort=127.0.0.1:11084:11084
# compose `cgroup: host`; no native quadlet key
PodmanArgs=--cgroupns=host
LogDriver=journald

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
