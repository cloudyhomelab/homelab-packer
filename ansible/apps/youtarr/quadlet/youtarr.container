[Unit]
Description=Youtarr
After=youtarr-database.service
Requires=youtarr-database.service

[Container]
ContainerName=youtarr
Image=youtarr.image
Network=youtarr.network
User=1000:1000
Volume=/srv/youtarr/media:/usr/src/app/data
Volume=/srv/youtarr/config:/app/config
Volume=/srv/youtarr/jobs:/app/jobs
Volume=/srv/youtarr/images:/app/server/images
PublishPort=3087:3011
EnvironmentFile=/var/app/youtarr/config/youtarr.env
EnvironmentFile=/run/app/youtarr/private/db.env
HealthCmd=curl --fail --silent --output /dev/null http://localhost:3011/api/health
HealthInterval=30s
HealthStartPeriod=40s
HealthRetries=3
Notify=healthy

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
