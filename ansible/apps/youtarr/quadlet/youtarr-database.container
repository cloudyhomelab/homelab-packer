[Unit]
Description=Youtarr MariaDB
After=youtarr-storage.service
Requires=youtarr-storage.service

[Container]
SubUIDMap=youtarr
SubGIDMap=youtarr
# root in the container gets no override on NFS; the server checks the real owner
User=999:999
ContainerName=youtarr_mariadb
Image=youtarr-database.image
Network=youtarr.network
NetworkAlias=database
Volume=/srv/youtarr/db:/var/lib/mysql
EnvironmentFile=/var/app/youtarr/config/youtarr.env
EnvironmentFile=/run/app/youtarr/private/db.env
Exec=--character-set-server=utf8mb4 --collation-server=utf8mb4_unicode_ci
HealthCmd=healthcheck.sh --connect --innodb_initialized
HealthInterval=10s
HealthStartPeriod=30s
HealthRetries=10
Notify=healthy

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
