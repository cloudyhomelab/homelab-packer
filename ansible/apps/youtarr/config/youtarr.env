# DB_PASSWORD and MARIADB_PASSWORD are in private/db.sops.env, decrypted on the VM

DB_HOST=database
DB_PORT=3306
DB_NAME=youtarr
DB_USER=youtarr

MARIADB_DATABASE=youtarr
MARIADB_USER=youtarr
MARIADB_RANDOM_ROOT_PASSWORD=1
MARIADB_AUTO_UPGRADE=1

AUTH_ENABLED=true
LOG_LEVEL=info

YOUTUBE_OUTPUT_DIR=/srv/youtarr/media
