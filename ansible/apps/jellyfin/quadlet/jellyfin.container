[Unit]
Description=Jellyfin
After=jellyfin-storage.service
Requires=jellyfin-storage.service
RequiresMountsFor=/srv/youtarr/media

[Container]
SubUIDMap=jellyfin
SubGIDMap=jellyfin
User=1000:1000
ContainerName=jellyfin
Image=jellyfin.image
Volume=/srv/jellyfin/config:/config
Volume=/srv/jellyfin/cache:/cache
Volume=/srv/youtarr/media:/media/youtarr:ro
PublishPort=8096:8096
Environment=JELLYFIN_PublishedServerUrl=https://jellyfin.cloudyhome.net
HealthCmd=curl -fsS http://localhost:8096/health -o /dev/null
HealthInterval=30s
HealthStartPeriod=2m
HealthRetries=5
Notify=healthy

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
