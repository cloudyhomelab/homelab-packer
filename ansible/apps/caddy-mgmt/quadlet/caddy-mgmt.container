[Unit]
Description=Caddy Management VLAN proxy
Wants=network-online.target
After=network-online.target caddy-mgmt-storage.service
Requires=caddy-mgmt-storage.service
StartLimitBurst=5
StartLimitIntervalSec=300

[Container]
SubUIDMap=caddy-mgmt
SubGIDMap=caddy-mgmt
# root in the container gets no override on NFS; the server checks the real owner
User=1000:1000
Sysctl=net.ipv4.ip_unprivileged_port_start=443
ContainerName=caddy-mgmt
Image=caddy-mgmt.image
Network=caddy-mgmt.network
Volume=/var/app/caddy-mgmt/config/Caddyfile:/etc/caddy/Caddyfile:ro
EnvironmentFile=/run/app/caddy-mgmt/private/porkbun.env
Volume=/srv/caddy-mgmt/data:/data
Volume=caddy-config.volume:/config:U
ReadOnly=true
PublishPort=443:443
LogDriver=journald

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
