# issued centrally by the acme app and fetched by caddy-mgmt-cert
(wildcard) {
    tls /data/wildcard/_.cloudyhome.net.crt /data/wildcard/_.cloudyhome.net.key
}

(upstream) {
    header_up Host {host}
}

# the edge routes by SNI, but browsers reuse an HTTP/2 connection for any host the wildcard
# certificate covers; 421 makes them retry on a new connection that reaches the right caddy
*.cloudyhome.net {
    import wildcard

    respond 421
}

gateway.cloudyhome.net {
    import wildcard

    reverse_proxy https://gateway.ip.cloudyhome.net:8443 {
        import upstream

        transport http {
            tls_insecure_skip_verify
        }
    }
}

sw1.cloudyhome.net {
    import wildcard

    reverse_proxy https://sw1.ip.cloudyhome.net:443 {
        import upstream

        transport http {
            tls_insecure_skip_verify
        }
    }
}

uos.cloudyhome.net {
    import wildcard

    reverse_proxy https://uos.ip.cloudyhome.net:11443 {
        import upstream

        transport http {
            tls_insecure_skip_verify
        }
    }
}

proxmox.cloudyhome.net {
    import wildcard

    reverse_proxy https://pve1.ip.cloudyhome.net:8006 \
                  https://pve2.ip.cloudyhome.net:8006 \
                  https://pve3.ip.cloudyhome.net:8006 {
        import upstream

        lb_policy random
        health_uri /
        health_status 200
        health_interval 10s
        health_timeout 3s

        transport http {
            tls_insecure_skip_verify
        }
    }
}

pve-edge.cloudyhome.net {
    import wildcard

    reverse_proxy https://pve-lab-1.ip.cloudyhome.net:8006 {
        import upstream
    }
}

pve-infra.cloudyhome.net {
    import wildcard

    reverse_proxy https://pve-infra-1.ip.cloudyhome.net:8006 {
        import upstream
    }
}

s3.cloudyhome.net {
    import wildcard

    reverse_proxy moria.ip.cloudyhome.net:9002 {
        import upstream
    }
}

s3-api.cloudyhome.net {
    import wildcard

    reverse_proxy moria.ip.cloudyhome.net:9000 {
        import upstream
    }
}

nas.cloudyhome.net {
    import wildcard

    reverse_proxy moria.ip.cloudyhome.net:80 {
        import upstream
    }
}

netbox.cloudyhome.net {
    import wildcard

    reverse_proxy netbox.ip.cloudyhome.net:8080 {
        import upstream
    }
}
