RCLONE_CONFIG_CERTS_TYPE=s3
RCLONE_CONFIG_CERTS_PROVIDER=Other
RCLONE_CONFIG_CERTS_ENDPOINT=http://moria.ip.cloudyhome.net:9000
RCLONE_CONFIG_CERTS_REGION=home
# the key may only read objects
RCLONE_CONFIG_CERTS_NO_CHECK_BUCKET=true
# rides out a flaky link at boot: 10 attempts, 15s apart
RCLONE_RETRIES=10
RCLONE_RETRIES_SLEEP=15s
