# issued centrally by the acme app and fetched by caddy-observability-cert
(wildcard) {
    tls /data/wildcard/_.cloudyhome.net.crt /data/wildcard/_.cloudyhome.net.key
}

(upstream) {
    header_up Host {host}
}

grafana.cloudyhome.net {
    import wildcard

    reverse_proxy grafana:3000 {
        import upstream
    }
}

prometheus.cloudyhome.net {
    import wildcard

    @ingest {
        method POST
        path /api/v1/write
    }

    handle @ingest {
        reverse_proxy prometheus:9090 {
            import upstream
        }
    }

    respond 403
}

loki.cloudyhome.net {
    import wildcard

    @ingest {
        method POST
        path /loki/api/v1/push
    }

    handle @ingest {
        reverse_proxy loki:3100 {
            import upstream
        }
    }

    respond 403
}
