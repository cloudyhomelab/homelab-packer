{
    acme_dns porkbun {
        api_key {$PORKBUN_API_KEY}
        api_secret_key {$PORKBUN_API_SECRET_KEY}
    }
}

(upstream) {
    header_up Host {host}
}

grafana.cloudyhome.net {
    reverse_proxy grafana:3000 {
        import upstream
    }
}

prometheus.cloudyhome.net {
    @ingest {
        method POST
        path /api/v1/write
    }

    handle @ingest {
        reverse_proxy prometheus:9090 {
            import upstream
        }
    }

    respond 403
}

loki.cloudyhome.net {
    @ingest {
        method POST
        path /loki/api/v1/push
    }

    handle @ingest {
        reverse_proxy loki:3100 {
            import upstream
        }
    }

    respond 403
}
