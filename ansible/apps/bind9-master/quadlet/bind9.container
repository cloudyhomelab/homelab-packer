[Unit]
Description=BIND9 authoritative DNS (primary)
Wants=network-online.target
After=network-online.target
StartLimitBurst=5
StartLimitIntervalSec=300

[Container]
ContainerName=bind9
Image=bind9.image
Network=host
Environment=BIND9_USER=root
Volume=/var/app/bind9-master/config/named.conf:/etc/bind/named.conf:ro
Volume=/var/app/bind9-master/config/zone-master.conf:/etc/bind/zone-master.conf:ro
# decrypted on the VM from private/
Volume=/run/app/bind9-master/private/tsig.keys:/etc/bind/tsig.keys:ro
Volume=/var/app/bind9-master/cache:/var/cache/bind
Volume=/var/app/bind9-master/records:/var/lib/bind
LogDriver=journald

[Service]
# seed zone files once; after that bind owns them (dynamic updates, journals)
ExecStartPre=/bin/sh -c 'for f in /var/app/bind9-master/config/zones/*.zone; do cp --update=none "$$f" /var/app/bind9-master/records/; done'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
