[Unit]
Description=BIND9 authoritative DNS (primary)
Wants=network-online.target
After=network-online.target
StartLimitBurst=5
StartLimitIntervalSec=300

[Container]
ContainerName=bind9
Image=bind9.image
Network=host
# -g, not the image's -L file: logs reach journald
Exec=-g -c /etc/bind/named.conf
Volume=/var/app/bind9-master/config/named.conf:/etc/bind/named.conf:ro
Volume=/var/app/bind9-master/config/zone-master.conf:/etc/bind/zone-master.conf:ro
# decrypted on the VM from private/
Volume=/run/app/bind9-master/private/tsig.keys:/etc/bind/tsig.keys:ro
Volume=/var/app/bind9-master/cache:/var/cache/bind
Volume=/var/app/bind9-master/records:/var/lib/bind
LogDriver=journald

[Service]
# not the U volume option: the container starts as root and named only drops to bind itself, so U would chown to root
ExecStartPre=/bin/chown 53:53 /run/app/bind9-master/private/tsig.keys
# seed zone files once; after that bind owns them (dynamic updates, journals)
ExecStartPre=/bin/sh -c 'for f in /var/app/bind9-master/config/zones/*.zone; do cp --update=none "$$f" /var/app/bind9-master/records/; done'
# a first boot has no blocklist until the fetch timer runs; an empty one keeps the zone loadable
ExecStartPre=/bin/sh -c 'test -f /var/app/bind9-master/cache/rpz.block.zone || cp /var/app/bind9-master/config/rpz.empty.zone /var/app/bind9-master/cache/rpz.block.zone'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
