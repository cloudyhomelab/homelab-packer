$TTL 2d
$ORIGIN cloudyhome.net.
@           IN      SOA     ns1.cloudyhome.net.                hostmaster.cloudyhome.net. (
                            2026111201         ;serial
                            12h                                 ;refresh
                            15m                                 ;retry
                            3w                                  ;expire
                            2h                                  ;minimum ttl
                            )

            IN      NS      ns1.cloudyhome.net.
            IN      NS      ns2.cloudyhome.net.

ns1 IN A 10.88.53.11
ns2 IN A 10.88.53.12
ip IN NS ns1.cloudyhome.net.
ip IN NS ns2.cloudyhome.net.
