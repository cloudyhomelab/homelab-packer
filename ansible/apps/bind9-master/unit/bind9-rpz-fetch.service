[Unit]
Description=Fetch the HaGeZi Multi NORMAL blocklist and reload the primary
Requires=bind9-rpz-download.service
After=bind9-rpz-download.service bind9.service

[Service]
Type=oneshot
Environment=RPZ_DIR=/var/app/bind9-master/cache
# checked by the named that will load it, so a truncated or malformed download never replaces a good list
ExecStart=/usr/bin/podman exec bind9 named-checkzone rpz.block /var/cache/bind/rpz.block.zone.new
ExecStart=/bin/mv -f ${RPZ_DIR}/rpz.block.zone.new ${RPZ_DIR}/rpz.block.zone
# SIGHUP rather than rndc: no control channel or key to manage
ExecStart=/usr/bin/podman kill --signal HUP bind9
