[Unit]
Description=Immich PostgreSQL
After=immich-storage.service
Requires=immich-storage.service

[Container]
SubUIDMap=immich
SubGIDMap=immich
# root in the container gets no override on NFS; the server checks the real owner
User=999:999
ContainerName=immich_postgres
Image=immich-database.image
Network=immich.network
NetworkAlias=database
Volume=/srv/immich/db:/var/lib/postgresql/data
EnvironmentFile=/var/app/immich/config/immich.env
EnvironmentFile=/run/app/immich/private/db.env
ShmSize=128m
HealthCmd=/bin/sh -c 'pg_isready --dbname="$${DB_DATABASE_NAME}" --username="$${DB_USERNAME}" || exit 1'
HealthInterval=10s
HealthStartPeriod=20s
HealthRetries=10
Notify=healthy

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
