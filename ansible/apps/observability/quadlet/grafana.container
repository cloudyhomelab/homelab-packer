[Unit]
Description=Grafana
Wants=network-online.target
After=network-online.target prometheus.service loki.service
StartLimitBurst=5
StartLimitIntervalSec=300

[Container]
ContainerName=grafana
Image=grafana.image
Network=observability.network
Volume=/var/app/observability/config/grafana/provisioning:/etc/grafana/provisioning:ro
Volume=/srv/grafana:/var/lib/grafana
# installed at image build; Grafana must not replace them at start
Volume=/usr/local/share/grafana/plugins:/var/lib/grafana/plugins:ro
Environment=GF_PLUGINS_PREINSTALL_AUTO_UPDATE=false
Environment=GF_ANALYTICS_REPORTING_ENABLED=false
Environment=GF_ANALYTICS_CHECK_FOR_UPDATES=false
Environment=GF_ANALYTICS_CHECK_FOR_PLUGIN_UPDATES=false
Environment=GF_LOG_CONSOLE_FORMAT=json
# alert messages link here
Environment=GF_SERVER_ROOT_URL=https://grafana.cloudyhome.net
Environment=GF_AUTH_GENERIC_OAUTH_ENABLED=true
Environment="GF_AUTH_GENERIC_OAUTH_NAME=Pocket ID"
Environment=GF_AUTH_GENERIC_OAUTH_AUTH_URL=https://auth.cloudyhome.net/authorize
Environment=GF_AUTH_GENERIC_OAUTH_TOKEN_URL=https://auth.cloudyhome.net/api/oidc/token
Environment=GF_AUTH_GENERIC_OAUTH_API_URL=https://auth.cloudyhome.net/api/oidc/userinfo
Environment="GF_AUTH_GENERIC_OAUTH_SCOPES=openid email profile groups"
Environment=GF_AUTH_GENERIC_OAUTH_USE_PKCE=true
Environment=GF_AUTH_GENERIC_OAUTH_LOGIN_ATTRIBUTE_PATH=preferred_username
# synced on every login: leaving the group drops the user to Viewer
Environment="GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_PATH=contains(groups[*], 'admin') && 'GrafanaAdmin' || 'Viewer'"
Environment=GF_AUTH_GENERIC_OAUTH_ALLOW_ASSIGN_GRAFANA_ADMIN=true
# the local admin keeps working for API calls with basic auth
Environment=GF_AUTH_DISABLE_LOGIN_FORM=true
# the secrets, decrypted on the VM from private/grafana.sops.env and private/oauth2.sops.env
EnvironmentFile=/run/app/observability/private/grafana.env
EnvironmentFile=/run/app/observability/private/oauth2.env
LogDriver=journald

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
