[Unit]
Description=Loki
Wants=network-online.target
After=network-online.target
StartLimitBurst=5
StartLimitIntervalSec=300

[Container]
ContainerName=loki
Image=loki.image
Network=observability.network
Volume=/var/app/observability/config/loki.yml:/etc/loki/loki.yml:ro
Volume=/srv/loki:/loki
Exec=-config.file=/etc/loki/loki.yml
PublishPort=3100:3100
LogDriver=journald

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
