    {
      "id": 11,
      "type": "logs",
      "title": "Firewall log",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 16
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=\"filterlog\", instance=~\"$instance\", interface=~\"$interface\"} | action=~\"$action\" | src=~\"$src\" | dst=~\"$dst\" | dst_port=~\"$port\" | line_format `{{ printf \"%-5s\" .action }} {{ printf \"%-8s\" .interface }} {{ printf \"%-3s\" .direction }} {{ printf \"%-5s\" .proto }} {{ .src }}{{ if .src_port }}:{{ .src_port }}{{ end }} → {{ .dst }}{{ if .dst_port }}:{{ .dst_port }}{{ end }}  {{ .tcp_flags }}  rule {{ .rule }}`",
          "queryType": "range"
        }
      ],
      "description": "action, interface, direction, protocol, source → destination, TCP flags, rule number",
      "options": {
        "showTime": true,
        "wrapLogMessage": false,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      }
    }
  ],
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "instance",
        "label": "Firewall",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "refId": "instance",
          "type": 1,
          "label": "instance",
          "stream": "{service_name=\"filterlog\"}"
        },
        "definition": "label_values({service_name=\"filterlog\"}, instance)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
