      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ],
          "sortBy": "Total",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Top blocked sources",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 8,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "topk(25, sum by (src, interface) (count_over_time({service_name=\"filterlog\", instance=~\"$instance\", interface=~\"$interface\"} | action=\"block\" | src=~\"$src\" | dst=~\"$dst\" | dst_port=~\"$port\" [$__range])))",
          "queryType": "instant",
          "format": "table"
        }
      ],
      "description": "Who is being blocked, and where",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "continuous-BlYlRd"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byType",
              "options": "number"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Entries"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic",
                  "valueDisplayMode": "text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "src"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Filter on this source",
                    "url": "/d/firewall?${__url_time_range}&${instance:queryparam}&${interface:queryparam}&var-src=${__value.raw}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "dst"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Filter on this destination",
                    "url": "/d/firewall?${__url_time_range}&${instance:queryparam}&${interface:queryparam}&var-dst=${__value.raw}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "dst_port"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Filter on this port",
                    "url": "/d/firewall?${__url_time_range}&${instance:queryparam}&${interface:queryparam}&var-port=${__value.raw}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Value #A",
                "desc": true
              }
            ]
          }
        }
      ]
    },
