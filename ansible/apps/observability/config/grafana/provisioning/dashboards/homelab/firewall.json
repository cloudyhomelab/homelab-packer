    {
      "id": 10,
      "type": "table",
      "title": "Rules hit",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "topk(50, sum by (rule, rule_id, action, interface) (count_over_time({service_name=\"filterlog\", instance=~\"$instance\", interface=~\"$interface\"} | action=~\"$action\" | src=~\"$src\" | dst=~\"$dst\" | dst_port=~\"$port\" [$__range])))",
          "queryType": "instant",
          "format": "table"
        }
      ],
      "description": "Rule number and label of every logged match; the label identifies the rule in the OPNsense GUI",
      "fieldConfig": {
        "defaults": {
