{
  "uid": "dns-queries",
  "title": "DNS queries",
  "tags": [
    "dns",
    "bind9"
  ],
  "editable": true,
  "schemaVersion": 41,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Queries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({container=\"bind9\", instance=~\"$instance\"} |= \"queries: info: client\" | regexp `client @\\S+ (?P<client>[^#]+)#\\d+ \\(\\S+\\): query: (?P<qname>\\S+) (?P<qclass>\\S+) (?P<qtype>\\S+) (?P<flags>\\S+)` | client=~\"$client\" | qname=~\"(?i).*$domain.*\" [$__range]))",
          "queryType": "instant"
        }
      ],
      "description": "Queries received in the time range",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "noValue": "0",
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
