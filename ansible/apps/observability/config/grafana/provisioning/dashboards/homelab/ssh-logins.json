{
  "uid": "ssh-logins",
  "title": "SSH logins",
  "description": "All panels query Loki: sshd's journal on every VM. A rejected line is one sshd logs at its default INFO level, so single failed key offers within MaxAuthTries do not show up; bare pre-auth disconnects (port scans, TCP health checks) are left out.",
  "tags": [
    "ssh",
    "security"
  ],
  "editable": true,
  "schemaVersion": 41,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "host",
        "label": "Host",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": "label_values({unit=~\"sshd?\\\\.service\"}, instance)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "type": "textbox",
        "name": "user",
        "label": "User",
        "description": "Regex on the account name",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        }
      },
      {
        "type": "textbox",
        "name": "client",
        "label": "Client",
        "description": "Regex on the client address",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Logins (24h)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({unit=~\"sshd?\\\\.service\", instance=~\"$host\"} |= \"Accepted \" | regexp `Accepted (?P<method>\\S+) for (?P<user>\\S+) from (?P<client>\\S+) port \\d+ [^\\s:]+(?:: \\S+ \\S+(?: ID (?P<key_id>.*) \\(serial (?P<serial>\\d+)\\))?)?` | user=~\"$user\" | client=~\"$client\" [24h]))",
          "queryType": "instant"
        }
      ],
      "description": "Successful logins in the last 24h, whatever the time picker says",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "noValue": "0",
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 1
    },
    {
