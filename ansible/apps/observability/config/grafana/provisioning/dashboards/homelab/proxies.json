{
  "uid": "proxies",
  "title": "Proxies",
  "description": "All panels query Loki: Caddy access logs and the edge's connection log. If the 7d panels get slow, move counts, error rates and latency to Caddy's Prometheus metrics (global `metrics { per_host }`, collected by each VM's Alloy); clients, paths and user agents stay on Loki.",
  "tags": [
    "proxy",
    "caddy",
    "haproxy"
  ],
  "editable": true,
  "schemaVersion": 41,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "panels": [
    {
      "type": "stat",
      "title": "Requests (1h)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({container=~\"$caddy\"} |= \"handled request\" | json host=`request.host`, client=`request.client_ip`, method=`request.method`, uri=`request.uri`, status=`status`, dur=`duration`, size=`size`, ua=`request.headers[\"User-Agent\"][0]` | host=~\"(?i).*$site.*\" | client=~\"$client\" [1h]))",
          "queryType": "instant"
        }
      ],
      "description": "Requests in the last 1h, whatever the time picker says",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "noValue": "0",
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 1
    },
