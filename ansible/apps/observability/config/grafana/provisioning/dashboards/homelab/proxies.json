      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "topk(25, sum by (host) (count_over_time({container=~\"$caddy\"} |= \"handled request\" | json host=`request.host`, client=`request.client_ip`, method=`request.method`, uri=`request.uri`, status=`status`, dur=`duration`, size=`size`, ua=`request.headers[\"User-Agent\"][0]` | host=~\"(?i).*$site.*\" | client=~\"$client\" [$__range])))",
          "queryType": "instant",
          "format": "table"
        }
      ],
      "description": "Requests per site",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "continuous-BlYlRd"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byType",
              "options": "number"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Requests"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic",
                  "valueDisplayMode": "text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
