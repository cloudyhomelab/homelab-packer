logging {
	level  = "warn"
	format = "json"
}

prometheus.exporter.unix "host" {
	enable_collectors = ["systemd"]
}

prometheus.scrape "host" {
	targets         = prometheus.exporter.unix.host.targets
	scrape_interval = "60s"
	forward_to      = [prometheus.remote_write.central.receiver]
}

prometheus.remote_write "central" {
	endpoint {
		url = "{{ observability_prometheus_url }}"
	}
}

loki.relabel "journal" {
	forward_to = []

	rule {
		source_labels = ["__journal__systemd_unit"]
		target_label  = "unit"
	}

	rule {
		source_labels = ["__journal_container_name"]
		target_label  = "container"
	}

	// podman logs all container stderr at priority err, so for containers the level is
	// left unset and Loki detects it from the line itself
	rule {
		source_labels = ["__journal_container_name", "__journal_priority_keyword"]
		regex         = ";(.+)"
		target_label  = "level"
	}

	// one Drilldown service per program instead of one for the whole journal;
	// each later rule matches only non-empty values so it overrides without erasing
	rule {
		source_labels = ["__journal_syslog_identifier"]
		regex         = "(.+)"
		target_label  = "service_name"
	}

	rule {
		source_labels = ["__journal__systemd_unit"]
		regex         = "(.+?)(\\.service)?"
		target_label  = "service_name"
	}

	rule {
		source_labels = ["__journal_container_name"]
		regex         = "(.+)"
		target_label  = "service_name"
	}
}

loki.source.journal "journal" {
	// the default 7h would skip what an outage longer than that left unshipped; the journal cap bounds it
	max_age       = "168h"
	relabel_rules = loki.relabel.journal.rules
	// same label as the host metrics, so logs and metrics correlate
	labels        = {instance = constants.hostname}
	forward_to    = [loki.write.central.receiver]
}

loki.write "central" {
	endpoint {
		url = "{{ observability_loki_url }}"
		// retry until Loki is up: the full queue then holds back the journal reader instead of dropping
		max_backoff_retries = 0
	}
}
