// restart only what the pre-hook stopped: a host or build that keeps fapolicyd off stays off
DPkg::Pre-Invoke { "if systemctl is-active --quiet fapolicyd; then touch /run/fapolicyd.apt-stopped && systemctl stop fapolicyd; fi"; };
DPkg::Post-Invoke { "if [ -e /run/fapolicyd.apt-stopped ]; then rm -f /run/fapolicyd.apt-stopped && systemctl start fapolicyd; fi"; };
