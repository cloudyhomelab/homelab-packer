#!/bin/sh
# The NFS server matches each export by name and caches a failed match, so nothing may mount
# before DNS maps this host's name to its own address and that address back to the name.
# The address must be local: a VM recreated on a new lease still finds its old A record.
set -u
interval=$1
fqdn=$(uname -n)

query() {
    resolvectl query --legend=no --cache=no --synthesize=no -t "$1" "$2" 2>/dev/null |
        awk -v type="$1" '$3 == type { sub(/\.$/, "", $4); print $4 }'
}

echo "waiting for DNS to map $fqdn to a local address and back"
while :; do
    for addr in $(query A "$fqdn"); do
        ip -4 -o addr show scope global | grep -qF " $addr/" || continue
        ptr=$(echo "$addr" | awk -F. '{ print $4 "." $3 "." $2 "." $1 ".in-addr.arpa" }')
        if query PTR "$ptr" | grep -qxF "$fqdn"; then
            echo "DNS maps $fqdn to $addr and back"
            exit 0
        fi
    done
    sleep "$interval"
done
