[Unit]
Description=Wait for DNS to map this host's name and address both ways
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec={{ app_storage_dns_timeout }}
ExecStart=/usr/local/libexec/app-storage-dns-wait {{ app_storage_dns_interval }}
