[Unit]
Description=Storage directories of {{ app_storage_app }}
RequiresMountsFor={{ app_storage_mounts | map(attribute='where') | join(' ') }}

[Service]
Type=oneshot
RemainAfterExit=yes
{% for dataset in app_storage_mounts %}
{% set paths = [dataset.where] + dataset.dirs %}
ExecStart=/usr/bin/mkdir -p {{ paths | join(' ') }}
ExecStart=/usr/bin/chown {{ dataset.owner }} {{ paths | join(' ') }}
ExecStart=/usr/bin/chmod {{ dataset.mode | default(app_storage_dir_mode) }} {{ paths | join(' ') }}
{% endfor %}

[Install]
WantedBy=multi-user.target
