[Unit]
Description=ImmichFrame
Requires=immich-server.service
After=immich-server.service

[Container]
ContainerName=immichframe
Image=ghcr.io/immichframe/immichframe:latest
Network=immich.network
Volume=/run/app/immich/private/Settings.yml:/app/Config/Settings.yml:ro
PublishPort=8080:8080
Environment=IMMICHFRAME_CONFIG_PATH=/app/Config
EnvironmentFile=/var/app/immich/config/immich.env

[Service]
Restart=always
RestartSec=10s
StartLimitBurst=20
StartLimitIntervalSec=600

[Install]
WantedBy=multi-user.target
