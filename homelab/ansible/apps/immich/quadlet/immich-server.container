[Unit]
Description=Immich Server
After=immich-redis.service immich-database.service immich-machine-learning.service immich-library.service
Requires=immich-redis.service immich-database.service immich-library.service
Wants=immich-machine-learning.service

[Container]
ContainerName=immich_server
Image=ghcr.io/immich-app/immich-server:${IMMICH_VERSION}
Network=immich.network
Volume=${UPLOAD_LOCATION}:/data
Volume=/etc/localtime:/etc/localtime:ro
PublishPort=2283:2283
EnvironmentFile=/var/app/immich/config/immich.env
EnvironmentFile=/run/app/immich/private/db.env
HealthCmd=/bin/sh -c 'curl -fsS http://localhost:2283/api/server/ping || exit 1'
HealthInterval=10s
HealthStartPeriod=30s
HealthRetries=10
Notify=healthy

[Service]
EnvironmentFile=/var/app/immich/config/immich.env
Restart=always

[Install]
WantedBy=multi-user.target
